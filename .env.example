# Credentials for `npm run tts` (pre-generating pronunciation audio).
# Copy to .env (gitignored) and fill in ONE provider.

# Azure Speech — portal.azure.com → create a "Speech service" resource (free tier F0 works)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# ...or Google Cloud TTS — console.cloud.google.com → enable "Cloud Text-to-Speech API" → API key
GOOGLE_TTS_KEY=

# Optional voice override (e.g. uk-UA-PolinaNeural, uk-UA-Wavenet-B)
TTS_VOICE=
