# Copy to .env (gitignored). Locally these feed `npm run tts` and `npm run dev`;
# on Vercel set the same names under Project → Settings → Environment Variables.

# ── Access gate ───────────────────────────────────────────────
# The course, scenarios and speech APIs are locked behind this shared code.
# Leave empty and everything is open (fine for local dev; NOT for production
# once ELEVENLABS_API_KEY is set).
SITE_PASSWORD=
# Optional: signs the login cookie. Derived from SITE_PASSWORD if unset.
# Rotate it to log everyone out without changing the code.
SESSION_SECRET=

# ── Text-to-speech (best available wins; the rest are per-phrase fallbacks) ──
# ElevenLabs — elevenlabs.io → profile → API keys. Model: eleven_multilingual_v2.
ELEVENLABS_API_KEY=
# Optional: voice id (default is the premade "George"). Pick any voice that
# handles Ukrainian well and paste its id from the Voices page.
ELEVENLABS_VOICE_ID=
# Azure Speech — portal.azure.com → "Speech service" (free tier F0 works)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Google Cloud TTS — console.cloud.google.com → enable "Cloud Text-to-Speech API" → API key
GOOGLE_TTS_KEY=
# Optional voice overrides (e.g. uk-UA-PolinaNeural, uk-UA-Wavenet-B)
AZURE_TTS_VOICE=
GOOGLE_TTS_VOICE=

# ── Speech-to-text (grading the "say it out loud" steps) ─────
# Uses ELEVENLABS_API_KEY above (Scribe). Optional model override:
ELEVENLABS_STT_MODEL=

# ── Runtime TTS safety valve ───────────────────────────────────
# /api/tts only synthesizes phrases that exist in src/data.js. Set to 1 to
# allow arbitrary text (not recommended on a public deployment).
TTS_ALLOW_ANY=
